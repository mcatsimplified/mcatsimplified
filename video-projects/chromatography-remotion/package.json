{
  "name": "chromatography-remotion",
  "version": "1.0.0",
  "description": "MCAT Simplified — Normal Phase vs. Reverse Phase Chromatography",
  "remotion": {
    "entryPoint": "./src/index.ts"
  },
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render ChromatographyVideo --output out/final.mp4",
    "render": "remotion render ChromatographyVideo --output out/final.mp4 --codec h264"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
